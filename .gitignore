# ZCode 工作区
.zcode/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node.js / Frontend
**/node_modules/
dist/
build/
# 构建时下载的 Node 运行时缓存（build-macos.sh / build-exe.ps1 用），不入库
vendor/node/
coverage/
jiuwenswarm/channels/web/frontend/logs/
jiuwenswarm/channels/web/frontend/cd
jiuwenswarm/channels/web/frontend/tsc
jiuwenswarm/channels/web/frontend/openjiuwen-web@0.1.0
jiuwenswarm/channels/tui/frontend/bun.lock
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env_personal
.env.local
.env.*.local
!.env.example

# docker-compose: certbot runtime state (issued certs, ACME webroot) — never commit
deploy/nginx/certbot-www/
deploy/nginx/letsencrypt/

# Apple code signing & notarization secrets — NEVER commit (contains private keys!)
*.p12
*.cer
*.mobileprovision
AuthKey_*.p8
DeveloperID_backup.p12
developerID_application.cer

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.claude/*
# Shared Claude Code rules are tracked; local overrides stay ignored.
!.claude/rules/
**/CLAUDE.md
**/CLAUDE.local.md
**/JIUWENCLAW.local.md
**/JIUWENCLAW.md
.jiuwen/settings.local.json
workspace/agent-data.json

# reference
reference/
openspec/
docs/ai/

# logs
logs/

# Browser automation runtime artifacts
.browser/
.browser-profiles/
.playwright-mcp/

# workspace
workspace/session
workspace/agent/memory/*.db
workspace/agent/memory/*.db-shm
workspace/agent/memory/*.db-wal

jiuwenswarm/workspace/.whatsapp-auth/
# Build-generated agent workspace resources are ignored by default, but the
# committed MCP builtins seed archive (mcp_builtins_v*.zip - ships the
# tencent-cos connector etc. into every fresh workspace, see
# _ensure_mcp_builtins in jiuwenswarm/common/utils.py) is a real, hand-
# maintained source asset, not a build artifact - keep it trackable so a
# plain `git add` on a version bump doesn't silently need `-f`.
jiuwenswarm/resources/agent/workspace/*
!jiuwenswarm/resources/agent/workspace/mcp_builtins_v*.zip
# Ship the in-repo designer AgentGroup (design team leader/worker templates).
!jiuwenswarm/resources/agent/workspace/plugins/
!jiuwenswarm/resources/agent/workspace/plugins/agent_groups/
!jiuwenswarm/resources/agent/workspace/plugins/agent_groups/designer/
jiuwenswarm/resources/tui/bin/
packages/jiuwenswarm-tui/jiuwenswarm_tui/resources/tui/bin/
packages/jiuwenswarm-tui/jiuwenswarm_tui/resources/tui-bin/

.crossnote/
.trae/
.reasonix/
reasonix.toml

# Build-time Node runtime cache used by packaging scripts.
vendor/node/
# oh-my-codex runtime artifacts (never tracked)
.omx/
/AGENTS.local.md
report/index.html
/tmp/
/memory/
/sub_agents/
/context/
/.plans/
designer_catalog_skills_reports_trajectory/runs/*
/todo/

# Local testing handoff documents are not versioned.
/.agents/agent-docs/designs/testing/
