# Copy to .env and fill in real values. Never commit .env.
#
# Used by docker-compose.yml (postgres + app) and deploy/init-letsencrypt.sh.

# --- Postgres ---
POSTGRES_USER=jiuwenswarm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jiuwenswarm

# --- Login gate (seeded into app_users on first boot, if the table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Let's Encrypt / domain ---
DOMAIN=happypeaceland.net
LETSENCRYPT_EMAIL=you@example.com

# --- Main chat/LLM model (plain env vars - see jiuwenswarm/resources/.env.template) ---
API_KEY=
API_BASE=
MODEL_NAME=
MODEL_PROVIDER=

# --- Director Mode: video generation model ---
VIDEO_GEN_ENABLED=false
VIDEO_GEN_PROVIDER=
VIDEO_GEN_PROTOCOL=
VIDEO_GEN_API_BASE=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL_NAME=

# --- Director Mode: image generation model ---
VISUAL_GEN_ENABLED=false
VISUAL_GEN_PROVIDER=
VISUAL_GEN_PROTOCOL=
VISUAL_GEN_API_BASE=
VISUAL_GEN_API_KEY=
VISUAL_GEN_MODEL_NAME=

# --- Director Mode: audio generation / TTS model ---
AUDIO_GEN_ENABLED=false
AUDIO_GEN_API_BASE=
AUDIO_GEN_API_KEY=
AUDIO_GEN_MODEL_NAME=
