# Copy to .env and fill in real values. Never commit .env.
#
# Used by docker-compose.yml (postgres + authgate + app) and
# deploy/init-letsencrypt.sh.

# --- Postgres ---
POSTGRES_USER=jiuwenswarm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jiuwenswarm

# --- Login gate (seeded into authgate's app_users table on first boot, if
#     the table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Let's Encrypt / domain ---
DOMAIN=workswarm.app
LETSENCRYPT_EMAIL=you@example.com

# --- Main chat/LLM model (plain env vars - see jiuwenswarm/resources/.env.template) ---
API_KEY=
API_BASE=
MODEL_NAME=
MODEL_PROVIDER=
