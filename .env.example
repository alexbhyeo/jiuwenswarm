# Copy to .env and fill in real values. Never commit .env.
#
# Used by docker-compose.yml (postgres + app) and deploy/init-letsencrypt.sh.

# --- Postgres ---
POSTGRES_USER=jiuwenswarm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jiuwenswarm

# --- Login gate (seeded into app_users on first boot, if the table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Let's Encrypt / domain ---
DOMAIN=happypeaceland.net
LETSENCRYPT_EMAIL=you@example.com
